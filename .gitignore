# Python environments & bytecode
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/build/
/dist/
.pytest_cache/

# Node.js dependencies
node_modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & IDE metadata
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large ONNX binary model weights (>100 MB limit, published to Hugging Face Hub)
models/onnx/*.onnx
!models/onnx/heads/
models/onnx_mobile/*.onnx
!models/onnx_mobile/heads/
models/heads/
models/heads_mobile/

# Temporary / Scratch audio files & benchmark cache
*.wav
!docs/samples/*.wav
*.mp3
*.mp4
*.gif
*.flac
*.ogg
*.pt
*.parquet
tools/.en_accent_cal_cache/
bench/.slang_accent_cache/
bench/*_results*.json
bench/results.json
temp_*
*.tmp

# Teamwork agent metadata
.agents/

# Secrets and local credentials
.env
.env.*
*.pem
*.key
*credentials*.json

# LaTeX build scratch files
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
